{
  "appId": "com.personaldiary.app",
  "appName": "Personal Diary",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://personaldiary15.vercel.app",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": ["personaldiary15.vercel.app"]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#0c0c17",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
